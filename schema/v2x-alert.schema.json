{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "v2x-alert/1.0",
  "title": "V2X alert",
  "description": "Alert raised by V2X-SERVICE (origin cloud) or by an RSU (origin rsu-1 / rsu-2). Cloud alerts travel V2X-SERVICE -> SNS v2x-alerts -> RSU -> MQTT -> vehicles.",
  "type": "object",
  "required": ["alert_id", "alert_type", "origin", "severity", "created_time", "valid_until",
               "zona", "location", "cause_event_ids", "message", "schema_version"],
  "properties": {
    "alert_id": {"type": "string", "description": "Deterministic: the same situation always gives the same ID (idempotency key)"},
    "alert_type": {"enum": ["sudden_braking", "crash", "emergency_priority", "collision_risk", "road_hazard", "congestion"]},
    "origin": {"enum": ["cloud", "rsu-1", "rsu-2"]},
    "severity": {"type": "integer", "minimum": 1, "maximum": 3},
    "created_time": {"type": "string", "description": "ISO 8601 UTC"},
    "valid_until": {"type": "string", "description": "ISO 8601 UTC; vehicles ignore the alert afterwards"},
    "zona": {"enum": ["rsu-1", "rsu-2", "broadcast"], "description": "SNS message attribute used by the subscription filters"},
    "location": {
      "type": "object", "required": ["segment_id", "rsu_id"],
      "properties": {"segment_id": {"type": "string", "pattern": "^S[0-9]{2}$"},
                     "rsu_id": {"enum": ["rsu-1", "rsu-2"]}}
    },
    "cause_event_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "message": {"type": "string"},
    "schema_version": {"const": "1.0"},
    "published": {"type": "boolean", "description": "Stored in DynamoDB only: true once SNS accepted the alert"},
    "published_time": {"type": "string"}
  },
  "additionalProperties": false
}
